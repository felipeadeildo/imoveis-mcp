{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "ignorePatterns": ["worker-configuration.d.ts", "test/fixtures/**"],
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-redundant-type-constituents": "error"
  },
  "overrides": [
    {
      // Tests stub `fetch`, cast saved pages to the shapes they are, and build
      // an `Env` without a runtime. Assertions are the point there; in `src/`
      // the same rules stay on, because that is the code that ships.
      "files": ["test/**"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/await-thenable": "off"
      }
    }
  ]
}
