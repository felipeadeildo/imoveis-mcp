{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imoveis-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "secrets": { "required": ["MCP_TOKEN"] },
  "vars": {
    "PAGE_TTL": "600",
    "MAX_PAGE_BYTES": "4000000",
  },
  "workers_dev": true,
}
